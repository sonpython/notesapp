# Production Environment Variables
# Copy to .env.production and fill in values

# ===========================================
# CLOUDFLARE TUNNEL (no static IP needed)
# ===========================================
# Get token from: Cloudflare Dashboard > Zero Trust > Networks > Tunnels
# Create tunnel > Copy token (starts with eyJ...)
CLOUDFLARE_TUNNEL_TOKEN=

# ===========================================
# DOMAIN & ORIGINS
# ===========================================
DOMAIN=notes.yourdomain.com
WEBAUTHN_RP_ID=notes.yourdomain.com
WEBAUTHN_RP_NAME=NotesApp
WEBAUTHN_ORIGIN=https://notes.yourdomain.com
CORS_ORIGINS=https://notes.yourdomain.com
PUBLIC_API_URL=https://notes.yourdomain.com

# ===========================================
# DATABASE (Self-hosted PostgreSQL)
# ===========================================
DB_PASSWORD=your-secure-db-password

# ===========================================
# AUTH (generate with: openssl rand -hex 32)
# ===========================================
JWT_SECRET=your-64-char-random-secret-here
JWT_EXPIRY_DAYS=7

# ===========================================
# MINIO / S3 STORAGE (Self-hosted)
# ===========================================
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=notesapp-images

# ===========================================
# TELEGRAM BOT (optional)
# ===========================================
TELEGRAM_BOT_TOKEN=

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=5/minute
