# Environment Configuration
# Copy to .env.development (local dev) or .env.production (prod build)

# Client-side API URL
# IMPORTANT: Keep empty for relative URLs - works with Vite proxy (dev) and reverse proxy (prod)
# NEVER set to internal Docker hostnames like "backend:8000"
PUBLIC_API_URL=

# WebAuthn origin (for passkey registration)
# Development: http://localhost:3000
# Production: https://notes.sonpython.com
PUBLIC_ORIGIN=http://localhost:3000
